# Plantilla de configuracion. Copiala a .env y captura los valores reales:
#     cp backend/.env.example backend/.env

PORT=3050

# ---------------------------------------------------------------------
# Conexion principal (default): base de datos MySQL de SIModpersonal.
# DB_HOST: host.docker.internal si MySQL esta en tu maquina y el backend en Docker;
#          localhost si el backend corre con npm.
# ---------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=simodpersonal

# ---------------------------------------------------------------------
# Conexion externa (adminplem_saf, MySQL): usuarios para el login (igual que SIPresupuesto).
# ---------------------------------------------------------------------
DB_EXTERNAL_HOST=
DB_EXTERNAL_PORT=3306
DB_EXTERNAL_USERNAME=
DB_EXTERNAL_PASSWORD=
DB_EXTERNAL_DATABASE=

# Secreto de firma del token. Generalo con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800

# ---------------------------------------------------------------------
# Recuperacion de contrasena por correo.
# FRONTEND_URL: direccion publica del frontend (para armar el enlace del correo).
# Si SMTP_HOST queda vacio, el enlace se escribe en el log del backend (solo desarrollo).
# ---------------------------------------------------------------------
FRONTEND_URL=http://localhost:4220
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SIModpersonal <no-reply@congresoedomex.gob.mx>
